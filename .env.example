# Copy to .env and adjust. All values below are optional with sane defaults.

# Django
DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — omit for local SQLite (default).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Cache — omit to use in-memory LocMemCache (dev/tests run with no Redis).
# REDIS_URL=redis://127.0.0.1:6379/0

# Fuel optimizer constants (defaults match the assignment brief).
MAX_RANGE_MILES=500
MPG=10
MAX_DETOUR_MILES=10
